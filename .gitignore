# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Build and packaging output
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Dependency and tool caches
.cache/
.tox/
.nox/

# IDE/editor files
.idea/
.vscode/
*.swp
*.swo

# Logs and local runtime files
*.log
logs/
tmp/
temp/

# Nested Git metadata from accidental clones.
# Keep source files in nested folders trackable, but never commit their .git data.
**/.git/
./docx/*

# Local development tracker
nx_agent/docx/progress.md
tests_local/*